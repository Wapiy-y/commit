# Cloudflare Workers Assets honours this file. Hashed assets are immutable; the
# three entry points must revalidate, or a browser can keep serving a shell that
# points at bundles which no longer exist.
/index.html
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
